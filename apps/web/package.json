{
  "name": "@terrasplat/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:cesium": "node ../../scripts/prepare-cesium.mjs && node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:cesium",
    "dev": "vite",
    "prebuild": "npm run prepare:cesium",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.config.ts"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1", "cesium": "1.146.0" },
  "devDependencies": {
    "typescript": "5.9.3", "vite": "8.3.5", "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.5", "@playwright/test": "1.64.1",
    "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "@types/node": "24.10.1"
  }
}
